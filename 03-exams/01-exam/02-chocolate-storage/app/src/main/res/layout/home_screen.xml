<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeScreen">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Gastroenerite"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.037" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Would you like record some chocolate?"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/textView3"
        app:layout_constraintEnd_toStartOf="@+id/btn_goCustomerRecord"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:layout_constraintVertical_bias="0.5" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customer Section"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/rg_customerSection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2"
        app:layout_constraintVertical_bias="0.5" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Manager Section"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/btn_goCustomerSearch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rg_chocolateSection"
        app:layout_constraintVertical_bias="0.5" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chocolate Section"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/rg_chocolateSection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rg_customerSection"
        app:layout_constraintVertical_bias="0.5" />

    <Button
        android:id="@+id/btn_goCustomerRecord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Yes"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textView2"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:layout_constraintVertical_bias="0.019" />

    <RadioGroup
        android:id="@+id/rg_customerSection"
        android:layout_width="269dp"
        android:layout_height="153dp"
        app:layout_constraintBottom_toTopOf="@+id/textView7"
        app:layout_constraintEnd_toStartOf="@+id/btn_executeCustomerSection"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3"
        app:layout_constraintVertical_bias="0.5">

        <RadioButton
            android:id="@+id/rb_showAllCustomers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show all customers" />

        <RadioButton
            android:id="@+id/rb_editCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit some customer" />

        <RadioButton
            android:id="@+id/rb_deleteCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete some customer" />
    </RadioGroup>

    <Button
        android:id="@+id/btn_executeCustomerSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="149dp"
        android:text="Execute"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/rg_customerSection"
        app:layout_constraintTop_toBottomOf="@+id/btn_goCustomerRecord" />

    <Button
        android:id="@+id/btn_executeChocolateSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="176dp"
        android:layout_marginBottom="109dp"
        android:text="Execute"
        app:layout_constraintBottom_toTopOf="@+id/btn_goChocolateSearch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/rg_chocolateSection"
        app:layout_constraintTop_toBottomOf="@+id/btn_executeCustomerSection" />

    <RadioGroup
        android:id="@+id/rg_chocolateSection"
        android:layout_width="272dp"
        android:layout_height="186dp"
        app:layout_constraintBottom_toTopOf="@+id/textView8"
        app:layout_constraintEnd_toStartOf="@+id/btn_executeChocolateSection"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView7"
        app:layout_constraintVertical_bias="0.5">

        <RadioButton
            android:id="@+id/rb_showAllChocolates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show all chocolates" />

        <RadioButton
            android:id="@+id/rb_editChocolates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit some chocolate" />

        <RadioButton
            android:id="@+id/rb_deleteChocolate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete some chocolate" />
    </RadioGroup>

    <Button
        android:id="@+id/btn_goCustomerSearch"
        android:layout_width="177dp"
        android:layout_height="60dp"
        android:text="Customer Search"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_goChocolateSearch"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView8"
        app:layout_constraintVertical_bias="0.5" />

    <Button
        android:id="@+id/btn_goChocolateSearch"
        android:layout_width="177dp"
        android:layout_height="60dp"
        android:text="Chocolate Search"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_goCustomerSearch"
        app:layout_constraintTop_toBottomOf="@+id/textView8"
        app:layout_constraintVertical_bias="0.5" />

</androidx.constraintlayout.widget.ConstraintLayout>